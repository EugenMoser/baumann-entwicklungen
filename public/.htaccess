# ============================================================
# Apache-Konfiguration für statisches Next.js-Export
# Diese Datei wird beim Build automatisch in das "out/"-Verzeichnis kopiert.
# ============================================================

# --- Directory Index (index.html als Standarddatei) ---
DirectoryIndex index.html

# --- URL-Rewriting für Next.js Static Export ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Trailing-Slash-Redirect: /products/elektro → /products/elektro/
  # Verhindert 403-Fehler bei Verzeichnisanfragen ohne abschließenden Slash
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

  # Statische HTML-Dateien ausliefern (Next.js Static Export)
  # Wenn die URL kein echtes File/Verzeichnis ist, index.html probieren
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ /$1.html [L]
</IfModule>

# --- Komprimierung (gzip) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript
  AddOutputFilterByType DEFLATE application/json application/xml text/xml
  AddOutputFilterByType DEFLATE font/woff font/woff2 image/svg+xml
</IfModule>

# --- Cache-Laufzeiten ---
<IfModule mod_expires.c>
  ExpiresActive On

  # Next.js Static-Assets (Hash im Dateinamen → sicher 1 Jahr)
  <FilesMatch "^_next/">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>

  # Schriftarten – 1 Jahr
  ExpiresByType font/woff              "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType font/ttf               "access plus 1 year"
  ExpiresByType application/font-woff  "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # JavaScript & CSS – 1 Jahr
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript        "access plus 1 year"
  ExpiresByType text/css               "access plus 1 year"

  # Bilder – 1 Woche
  ExpiresByType image/png              "access plus 1 week"
  ExpiresByType image/jpeg             "access plus 1 week"
  ExpiresByType image/webp             "access plus 1 week"
  ExpiresByType image/gif              "access plus 1 week"
  ExpiresByType image/svg+xml          "access plus 1 week"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

  # HTML-Seiten – nicht cachen (damit Updates sofort sichtbar sind)
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

# --- Cache-Control-Header ---
<IfModule mod_headers.c>
  # Schriftarten und JS/CSS: 1 Jahr, unveränderlich
  <FilesMatch "\.(woff|woff2|ttf|eot|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Bilder: 1 Tag frisch, danach bis 7 Tage stale-while-revalidate
  <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>

  # HTML: immer aktuell prüfen
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
